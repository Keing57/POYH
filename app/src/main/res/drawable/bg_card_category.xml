<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#306C5CE7">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/card_gradient_end"
                android:endColor="@color/card_gradient_end"
                android:startColor="@color/card_gradient_start"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>
</ripple>
